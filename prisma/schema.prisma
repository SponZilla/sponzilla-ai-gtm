generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id       String  @id @default(uuid())
  name     String
  website  String?
  industry String?

  opportunities Opportunity[]
  contacts      Contact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

/// A reachable person at a company.
///
/// Email addresses are only trustworthy when emailStatus is VERIFIED.
/// UNVERIFIED covers addresses that were guessed, returned as
/// accept_all/unknown by a verification service, or never checked.
model Contact {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name  String
  title String?

  email       String?
  emailStatus EmailStatus @default(UNVERIFIED)

  linkedinUrl String?

  /// Where this contact was discovered (e.g. LINKEDIN, HUNTER, MANUAL).
  sourceProvider String?
  sourceUrl      String?

  verifiedAt DateTime?

  outreachDrafts OutreachDraft[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, email])
  @@index([companyId])
  @@index([emailStatus])
}

/// One enrichment answer, cached so the same identity is never paid for twice.
/// keyType is LINKEDIN_HANDLE or NAME_DOMAIN. A miss is stored as well
/// (hit = false) so a repeat lookup does not spend credits or latency again.
model EnrichmentLookup {
  id       String @id @default(uuid())
  provider String

  keyType String
  keyHash String
  /// Readable form of the hashed key, for debugging a row by eye.
  lookupKey String

  hit         Boolean
  email       String?
  emailStatus EmailStatus?
  confidence  Int?
  sourceUrl   String?
  linkedinUrl String?

  creditsUsed Int @default(0)
  expiresAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, keyType, keyHash])
  @@index([expiresAt])
}

model Opportunity {
  id        String @id @default(uuid())
  companyId String

  title  String
  source OpportunitySource
  stage  OpportunityStage  @default(NEW)

  estimatedBudget Decimal? @db.Decimal(12, 2)
  objective       String?

  lastInteractionAt DateTime?

  /// Stable Market Intelligence opportunity ID. Unique per owner rather than
  /// globally: the same research run is a separate card for each user who
  /// asked for it, and one user must never inherit another's card.
  externalId String?

  /// Full validated OpportunityV1 payload used by Decision Context.
  intelligenceSnapshot Json?

  /// Provenance of the opportunity, for example MARKET_INTELLIGENCE.
  origin String?

  /// Operator who claimed this card. Null is unclaimed intake, visible to any
  /// operator; once claimed the card belongs to that operator alone.
  ownerId String?

  company            Company                        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  interactions       Interaction[]
  decisions          GTMDecision[]
  marketIntelligence MarketIntelligenceOpportunity?
  outreachDrafts     OutreachDraft[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([stage])
  @@index([companyId, stage])
  @@index([ownerId])
  @@index([externalId, ownerId])
}

model MarketIntelligenceOpportunity {
  id                    String @id @default(uuid())
  externalOpportunityId String @unique
  contractVersion       String
  opportunityId         String @unique

  location String

  audience       String[]
  marketingNeed  String
  interpretation String

  inferenceConfidence Decimal @db.Decimal(5, 4)

  recommendation String
  nextActionHint String

  signals  Json
  evidence Json

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model Interaction {
  id            String @id @default(uuid())
  opportunityId String

  type    InteractionType
  summary String

  occurredAt DateTime

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([opportunityId])
  @@index([opportunityId, occurredAt])
}

model GTMDecision {
  id            String @id @default(uuid())
  opportunityId String

  action   GTMActionType
  priority DecisionPriority
  status   DecisionStatus   @default(AWAITING_APPROVAL)

  summary    String
  reasoning  String[]
  confidence Decimal  @db.Decimal(5, 4)

  inputSnapshot  Json
  proposedAction Json

  modelVersion  String
  promptVersion String
  policyVersion String

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)

  evidence   Evidence[]
  approvals  Approval[]
  executions Execution[]
  outcomes   Outcome[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([opportunityId, createdAt])
  @@index([status])
}

model Evidence {
  id         String @id @default(uuid())
  decisionId String

  sourceType EvidenceSourceType
  sourceId   String?

  claim String
  value String?

  decision GTMDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([decisionId])
  @@index([sourceType, sourceId])
}

model Approval {
  id         String @id @default(uuid())
  decisionId String

  status ApprovalStatus

  actorId   String
  actorName String?
  comment   String?

  actionSnapshot Json

  decision   GTMDecision @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  executions Execution[]

  createdAt DateTime @default(now())

  @@index([decisionId, createdAt])
  @@index([actorId])
}

model Execution {
  id         String @id @default(uuid())
  decisionId String
  approvalId String

  action GTMActionType
  status ExecutionStatus @default(PENDING)

  actionSnapshot Json
  result         Json?

  errorMessage String?

  // Recovery and reconciliation metadata.
  // Null means the execution has not yet
  // been claimed for dispatch.
  startedAt DateTime?

  // Updated by the execution worker while
  // actively processing an action.
  lastHeartbeatAt DateTime?

  // Set when an operator or recovery process
  // last inspected the execution.
  lastReconciledAt DateTime?

  decision GTMDecision @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  approval Approval    @relation(fields: [approvalId], references: [id], onDelete: Restrict)

  createdAt  DateTime  @default(now())
  executedAt DateTime?

  @@unique([decisionId])
  @@index([approvalId])
  @@index([status])
  @@index([status, startedAt])
}

model Outcome {
  id         String @id @default(uuid())
  decisionId String

  type OutcomeType

  value    Decimal? @db.Decimal(14, 2)
  metadata Json?

  occurredAt DateTime

  decision GTMDecision @relation(fields: [decisionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([decisionId, occurredAt])
  @@index([type])
}

enum EmailStatus {
  UNVERIFIED
  VERIFIED
  BOUNCED
}

enum OutreachDraftStatus {
  DRAFT
  APPROVED
  REJECTED
}

/// A generated outreach email awaiting explicit operator approval.
///
/// Nothing in this system sends email. An APPROVED draft is a
/// reviewed artifact and an audit record, not a delivery.
model OutreachDraft {
  id String @id @default(uuid())

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  action GTMActionType @default(SEND_INTRODUCTION)

  subject String
  body    String

  status OutreachDraftStatus @default(DRAFT)

  /// Which model wrote this, and its exact inputs, for audit.
  modelVersion  String?
  promptVersion String?
  inputSnapshot Json?

  approvedAt DateTime?
  approvedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([opportunityId])
  @@index([contactId])
  @@index([status])
}

enum OpportunitySource {
  INBOUND
  OUTBOUND
  REFERRAL
  PARTNER
  MARKET_INTELLIGENCE
}

enum OpportunityStage {
  NEW
  CONTACTED
  INTERESTED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum InteractionType {
  EMAIL_SENT
  EMAIL_RECEIVED
  CALL
  MEETING
  NOTE
  PROPOSAL_SENT
  PROPOSAL_REQUESTED
}

enum GTMActionType {
  REQUEST_MORE_INFORMATION
  RESEARCH_COMPANY
  SEND_INTRODUCTION
  SEND_CASE_STUDY
  SEND_CAMPAIGN_PROPOSAL
  SCHEDULE_DISCOVERY_CALL
  FOLLOW_UP
  PREPARE_PRICING
  ESCALATE_TO_SALES
  WAIT
  CLOSE_OPPORTUNITY
}

enum DecisionPriority {
  LOW
  MEDIUM
  HIGH
}

enum DecisionStatus {
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  DEFERRED
  EXECUTED
  FAILED
}

enum EvidenceSourceType {
  COMPANY
  OPPORTUNITY
  INTERACTION
  SYSTEM
}

enum ApprovalStatus {
  APPROVED
  REJECTED
  DEFERRED
}

enum ExecutionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum OutcomeType {
  EMAIL_OPENED
  REPLIED
  MEETING_BOOKED
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  OPPORTUNITY_WON
  OPPORTUNITY_LOST
}


model AdminAuditLog {
  id String @id @default(uuid())

  // Administrative operation performed
  action String

  // Type and ID of the affected resource
  resourceType String
  resourceId String?

  // Identifies the internal credential or service
  actorType String @default("INTERNAL_SERVICE")
  actorId String?

  // Result of the operation
  outcome String

  // Request correlation
  requestId String?

  // Optional structured, non-sensitive details
  metadata Json?

  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([resourceType, resourceId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}
