NODE_ENV=development
PORT=3000
# Supabase Connect → Session pooler URI (preferred for local Prisma)
# Encode special password chars: # → %23  @ → %40
# Example:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# 64-character hex key required by internal GTM handoff and admin routes.
INTERNAL_ADMIN_API_KEY=

# Human approve/reject routes validate the frontend's SponZilla JWT
# against the primary backend's protected /api/auth/me endpoint.
SPONZILLA_AUTH_API_URL=https://sponzilla-k13k.onrender.com

# Optional exact browser origins, comma-separated. Empty keeps browser access disabled.
CORS_ALLOWED_ORIGINS=

# Contact enrichment. Hunter runs first; Apollo is only asked for people Hunter
# could not find or could not confirm. Without either key, enrichment is
# reported as unconfigured and no Contact is created with an email.
# Owner attached to ingested cards when the research call carries no user.
# Set this to your Sponzilla user id for a single-operator pilot.
# GTM_DEFAULT_OWNER_ID=

# Comma-separated persona titles, highest priority first. Overrides the built-in
# ranking when set, for example:
# ICP_TARGET_TITLES=Head of Partnerships,Sponsorship Manager,Brand Partnerships
ICP_TARGET_TITLES=

# Default offering context used when a draft request omits a brief.
# GTM_OFFERING_BRIEF=We place community-led brand campaigns with measured reach.
GTM_OFFERING_BRIEF=

# HUNTER_API_KEY=
# APOLLO_API_KEY=
# Apollo is paused by default; set to true to use it as the fallback finder.
# APOLLO_ENRICHMENT_ENABLED=true

# Outreach drafting. gemini-2.0-flash and gemini-1.5-flash are retired by the
# API; the default is gemini-3.8-flash.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
